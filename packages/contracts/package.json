{
  "name": "@estene/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for domain enums, the order state machine, pricing math and API request schemas. Consumed by the API and every client.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    "./enums": "./src/enums.ts",
    "./pricing": "./src/pricing.ts",
    "./money": "./src/money.ts",
    "./common": "./src/common.ts",
    "./auth": "./src/auth.ts",
    "./zone": "./src/zone.ts",
    "./rider": "./src/rider.ts",
    "./client": "./src/client.ts",
    "./shipment": "./src/shipment.ts",
    "./shipment-status": "./src/shipment-status.ts",
    "./webhook-events": "./src/webhook-events.ts",
    "./payment": "./src/payment.ts",
    "./payout": "./src/payout.ts",
    "./banks": "./src/banks.ts",
    "./office": "./src/office.ts",
    "./manifest": "./src/manifest.ts",
    "./warehouse": "./src/warehouse.ts",
    "./portal": "./src/portal.ts"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@estene/config": "workspace:*",
    "vitest": "^3.2.4"
  }
}
